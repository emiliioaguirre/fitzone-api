        "description": "Devuelve un error al consultar una clase que no existe."
      }
    },
    {
      "name": "29. Consultar recordatorio enviado",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const espera = Math.max(0, Number(pm.collectionVariables.get(\"recordatorioDesde\")) + 6500 - Date.now());",
              "if (espera > 0) setTimeout(function () {}, espera);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Recordatorio registrado\", () => pm.expect(pm.response.json().recordatorioEnviado).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseURL}}/inscripciones/{{idInscripcion}}",
        "description": "Comprueba el recordatorio al llegar a las dos horas previas al inicio de la clase."
      }
    }
