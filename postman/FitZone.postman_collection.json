    {
      "name": "01. Registrar sucursal Centro",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ahora = Date.now();",
              "const fecha = ms => new Date(ms - 6 * 60 * 60 * 1000).toISOString().slice(0, 19);",
              "pm.collectionVariables.set(\"vigencia\", fecha(ahora + 30 * 86400000).slice(0, 10));",
              "pm.collectionVariables.set(\"vencida\", fecha(ahora - 86400000).slice(0, 10));",
              "pm.collectionVariables.set(\"inicioYoga\", fecha(ahora + 4 * 3600000));",
              "pm.collectionVariables.set(\"inicioFuncional\", fecha(ahora + 5 * 3600000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"idCentro\", String(pm.response.json().id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL}}/sucursales",
        "description": "Registra la sucursal Centro de FitZone.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Centro\",\n  \"direccion\": \"Veracruz Centro\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
